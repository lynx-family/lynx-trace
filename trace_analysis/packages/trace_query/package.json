{
  "name": "@lynx-js/trace-query",
  "version": "0.1.2",
  "description": "Lynx trace query library and CLI tool",
  "keywords": [
    "lynx",
    "trace",
    "performance",
    "analysis",
    "perfetto",
    "cli"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-family/lynx-trace.git",
    "directory": "trace_analysis/packages/trace_query"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "trace-query": "./dist/cli/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/compile_proto.mjs && tsc && npm run build:report-viewer",
    "build:report-viewer": "node ./scripts/build_report_viewer.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test:memory": "node scripts/test_memory_residual.cjs",
    "test:frontend": "node scripts/test_frontend_sources.cjs",
    "test:lynx-sources": "node scripts/test_lynx_sources.cjs",
    "test:source-preparation": "node scripts/test_source_preparation.cjs",
    "test:source-report": "node scripts/test_report_source_inventory.cjs"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "commander": "^11.0.0",
    "node-fetch": "^3.3.2",
    "protobufjs": "^8.7.2",
    "source-map-js": "^1.2.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "protobufjs-cli": "^2.6.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
